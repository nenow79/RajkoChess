STOCKFISH_PATH=/usr/games/stockfish
BOT_GLOBAL_ELO_OFFSET=-100
OPENROUTER_API_KEY=
LICHESS_API_TOKEN=
LLM_MODEL=google/gemini-3-flash-preview
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Rajko Chess Analyser
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=1
OPENROUTER_POSITION_MAX_TOKENS=800
OPENROUTER_GAME_MAX_TOKENS=1200
OPENROUTER_TRANSLATION_MAX_TOKENS=1400
BOT_DB_PATH=./data/bots.sqlite3

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5

# Authentication cookies (Secure=false only for local HTTP development)
AUTH_COOKIE_NAME=rajko_session
AUTH_CSRF_COOKIE_NAME=rajko_csrf
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_DAYS=7
AUTH_SESSION_ABSOLUTE_DAYS=30

# Publiczny adres frontendu i poczta transakcyjna (SMTP SSL/TLS)
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_USERNAME=noreply@rajko.pl
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@rajko.pl
SMTP_FROM_NAME=Rajko Chess
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60

# Redis dostępny wyłącznie lokalnie; sekret powinien być losowy na produkcji.
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_KEY_SECRET=zmien-na-losowy-sekret-produkcyjny
GLOBAL_ENGINE_CONCURRENCY=2
GLOBAL_FULL_ANALYSIS_CONCURRENCY=1
GLOBAL_LLM_CONCURRENCY=2
GLOBAL_EXTERNAL_API_CONCURRENCY=4
