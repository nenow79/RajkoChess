[Unit]
Description=Backup PostgreSQL Rajko Chess
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/ubuntu/Projekty/aplikacje/RajkoChess/deploy/backup-postgres.sh
Environment=ENV_FILE=/etc/rajko-chess/backend.env
Environment=BACKUP_DIR=/var/backups/rajko-chess
Environment=BACKUP_RETENTION_DAYS=14
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
