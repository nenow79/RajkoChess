STOCKFISH_PATH=/usr/games/stockfish
OPENROUTER_API_KEY=
LICHESS_API_TOKEN=
BOT_DB_PATH=/var/lib/rajko-chess/bots.sqlite3
LLM_MODEL=google/gemini-3-flash-preview
BOT_COMMENTARY_MODEL=sao10k/l3-lunaris-8b
OPENROUTER_HTTP_REFERER=https://example.com/chess/
OPENROUTER_APP_TITLE=Rajko Chess Analyser

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
POSTGRES_CONNECT_TIMEOUT=5

# Authentication cookies
AUTH_COOKIE_NAME=__Host-rajko_session
AUTH_CSRF_COOKIE_NAME=__Host-rajko_csrf
AUTH_COOKIE_SECURE=true
AUTH_SESSION_IDLE_DAYS=7
AUTH_SESSION_ABSOLUTE_DAYS=30

# Public frontend URL and transactional email (SMTP over SSL/TLS)
PUBLIC_APP_URL=https://example.com
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_USERNAME=noreply@rajko.pl
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@rajko.pl
SMTP_FROM_NAME=Rajko Chess
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60

# Redis and privacy-preserving rate-limit keys
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_KEY_SECRET=
GLOBAL_ENGINE_CONCURRENCY=2
GLOBAL_FULL_ANALYSIS_CONCURRENCY=1
GLOBAL_LLM_CONCURRENCY=2
GLOBAL_EXTERNAL_API_CONCURRENCY=4
